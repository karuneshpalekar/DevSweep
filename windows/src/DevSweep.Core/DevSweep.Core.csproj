<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>DevSweep.Core</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- The CLI is published with Native AOT; keep the engine trim/AOT clean at build time. -->
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.CsWin32" PrivateAssets="all" />
    <PackageReference Include="YamlDotNet" />
  </ItemGroup>

  <ItemGroup>
    <!-- The bundled Windows rule packs (windows/rules), read by EmbeddedRulePacks. -->
    <EmbeddedResource Include="..\..\rules\*.yml" LogicalName="DevSweep.Rules.%(Filename)%(Extension)" />
    <!-- The Windows packs module (M3a, module:packs): windows/rules/packs. -->
    <EmbeddedResource Include="..\..\rules\packs\*.yml" LogicalName="DevSweep.Packs.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DevSweep.Core.Tests" />
  </ItemGroup>

</Project>
